{
  "name": "codeee-cli",
  "version": "0.3.0",
  "description": "A code editor for the terminal, after VS Code: a file explorer, tabs, syntax highlighting in your VS Code theme, find and replace, and full mouse support.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "codeee": "dist/cli.js"
  },
  "files": [
    "dist",
    "config"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/illinifellow/codeee-cli.git"
  },
  "engines": {
    "node": ">=22.15"
  },
  "scripts": {
    "build": "node build.mjs",
    "prepare": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/cli.js",
    "coverage": "vitest run --coverage --reporter=default --reporter=json --outputFile.json=coverage/tests.json"
  },
  "dependencies": {
    "ink": "^8.0.0",
    "jsonc-parser": "^3.3.1",
    "react": "^19.3.0",
    "shiki": "^4.5.0",
    "string-width": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.3",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "keywords": [
    "editor",
    "code-editor",
    "tui",
    "terminal",
    "cli",
    "syntax-highlighting",
    "ink",
    "mouse"
  ],
  "author": "illinifellow",
  "homepage": "https://github.com/illinifellow/codeee-cli#readme",
  "bugs": {
    "url": "https://github.com/illinifellow/codeee-cli/issues"
  }
}
