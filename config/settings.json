        "dropdown": "\u25be",
        "settings": "\u2699"
      },
      "spacing": {
        "indent": 2,
        "toolbarGap": 3,
        "dialogWidth": 64,
        "menuWidth": 36,
        "paletteWidth": 72,
        "paletteRows": 12,
        "explorerMinWidth": 16,
        "editorMinWidth": 20,
        "findWidth": 28,
        "gutterPadding": 2,
