{
  "settings": {
    "theme": "auto",
    "tabSize": 2,
    "insertSpaces": true,
    "detectIndentation": true,
    "lineNumbers": true,
    "relativeLineNumbers": false,
    "highlightLine": true,
    "lineBlame": true,
    "colorDecorators": true,
    "bracketPairColorization": true,
    "guides": true,
    "minimap": true,
    "breadcrumbs": true,
    "wordWrap": false,
    "renderWhitespace": "all",
    "showFoldingControls": "always",
    "wrapTabs": true,
    "confirmDelete": false,
    "compactFolders": true,
    "stickyScroll": true,
    "eslint": true,
    "snippets": true,
    "autoSave": "off",
    "hotExit": "onExit",
    "autoIndent": true,
    "autoClosingBrackets": true,
    "trimTrailingWhitespace": false,
    "insertFinalNewline": false,
    "formatOnSave": false,
    "explorer": true,
    "wheelLines": 3,
    "exclude": [".git", ".svn", ".hg", "CVS", ".DS_Store", "Thumbs.db"],
    "searchExclude": [
      "node_modules",
      "dist",
      "build",
      "out",
      "coverage",
      ".next",
      ".turbo",
      ".cache",
      "target",
      "vendor",
      "__pycache__",
      ".venv",
      "venv"
    ],
    "iconTheme": "vscode"
  },
  "limits": {
    "maxFileMegabytes": 16,
    "highlightChunkLines": 120,
    "highlightMaxLines": 200000,
    "quickOpenFiles": 20000,
    "undoSteps": 500,
    "typingGroupMs": 800,
    "watchDebounceMs": 150,
    "refreshDelayMs": 300,
    "doubleClickMs": 400,
    "doubleClickCells": 2,
    "inputSplitMs": 20,
    "backgroundQueryMs": 150,
    "statusMs": 2500,
    "errorStatusMs": 6000,
    "updateCheckHours": 6,
    "rememberedPositions": 500,
    "recentFolders": 10,
    "lintDelayMs": 700,
    "autoSaveDelayMs": 1000
  },
  "columns": {
    "explorer": 30
  },
  "keys": {
    "save": "ctrl+s",
    "quit": "ctrl+q",
    "close": "ctrl+w",
    "newFile": "ctrl+n",
    "quickOpen": "ctrl+p",
    "goToLine": "ctrl+g",
    "find": "ctrl+f",
    "replace": "ctrl+r",
    "explorer": "ctrl+b",
    "focusExplorer": "ctrl+e",
    "settings": "ctrl+o",
    "undo": "ctrl+z",
    "redo": "ctrl+y",
    "copy": "ctrl+c",
    "cut": "ctrl+x",
    "paste": "ctrl+v",
    "selectAll": "ctrl+a",
    "selectLine": "ctrl+l",
    "deleteLine": "ctrl+k",
    "duplicateLine": "alt+shift+down",
    "comment": "ctrl+/",
    "moveLineUp": "alt+up",
    "moveLineDown": "alt+down",
    "nextTab": "ctrl+pagedown",
    "previousTab": "ctrl+pageup",
    "findNext": "f3",
    "findPrevious": "shift+f3",
    "format": "alt+shift+f",
    "search": "ctrl+t",
    "replaceInFiles": "ctrl+alt+t",
    "goToSymbol": "ctrl+]",
    "nextProblem": "f8",
    "previousProblem": "shift+f8",
    "markdownPreview": "alt+v",
    "reopenClosed": "alt+t",
    "toggleFold": "alt+k",
    "addNextOccurrence": "ctrl+d",
    "wordWrap": "alt+z",
    "foldAll": "alt+-",
    "unfoldAll": "alt+=",
    "duplicateLineUp": "alt+shift+up",
    "goBack": "ctrl+alt+left",
    "goForward": "ctrl+alt+right",
    "blockComment": "alt+shift+a",
    "saveAll": "alt+s",
    "addCursorAbove": "ctrl+alt+up",
    "addCursorBelow": "ctrl+alt+down",
    "expandSelection": "ctrl+shift+right",
    "shrinkSelection": "ctrl+shift+left",
    "scm": "alt+g",
    "outline": "alt+o"
  },
